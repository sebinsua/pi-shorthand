{
	"name": "pi-code",
	"version": "0.1.0",
	"private": true,
	"description": "Pi tool: make a change with one Bun program. Its writes are held in an overlay and applied only if it succeeds.",
	"type": "module",
	"scripts": {
		"test": "bun test",
		"typecheck": "tsc -p .",
		"lint": "oxlint",
		"format": "oxfmt",
		"check": "tsc -p . && oxlint && oxfmt --check",
		"prepare": "git config core.hooksPath .githooks"
	},
	"dependencies": {
		"@ast-grep/cli": "^0.45.3",
		"@ast-grep/napi": "^0.45.3",
		"@getgrit/cli": "0.1.0-alpha.1743007075",
		"diff": "^9.0.0"
	},
	"devDependencies": {
		"@mariozechner/pi-coding-agent": "^0.73.1",
		"@types/bun": "^1.4.2",
		"@types/node": "^26.6.1",
		"oxfmt": "^0.68.0",
		"oxlint": "^1.83.0",
		"typescript": "^7.0.2"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		],
		"skills": [
			"./skills"
		]
	}
}
