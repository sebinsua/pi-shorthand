{
	"name": "pi-shorthand",
	"version": "0.1.0",
	"description": "Pi tool for token-efficient writes: the model makes a whole change with one Bun program, whose writes are held in an overlay and applied only if it succeeds.",
	"keywords": [
		"ast-grep",
		"bun",
		"code-mode",
		"gritql",
		"overlay",
		"pi",
		"pi-extension",
		"pi-package"
	],
	"homepage": "https://github.com/sebinsua/pi-shorthand#readme",
	"bugs": "https://github.com/sebinsua/pi-shorthand/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sebinsua/pi-shorthand.git"
	},
	"files": [
		"*.ts",
		"skills",
		"README.md"
	],
	"type": "module",
	"scripts": {
		"test": "bun test",
		"typecheck": "tsc -p .",
		"lint": "oxlint --deny-warnings",
		"format": "oxfmt",
		"check": "tsc -p . && oxlint --deny-warnings && oxfmt --check",
		"prepare": "git config core.hooksPath .githooks 2>/dev/null || true"
	},
	"dependencies": {
		"@ast-grep/cli": "^0.45.3",
		"@ast-grep/napi": "^0.45.3",
		"@getgrit/cli": "0.1.0-alpha.1743007075",
		"diff": "^9.0.0"
	},
	"devDependencies": {
		"@mariozechner/pi-coding-agent": "^0.73.1",
		"@types/bun": "^1.4.2",
		"@types/node": "^26.6.1",
		"oxfmt": "^0.68.0",
		"oxlint": "^1.83.0",
		"typescript": "^7.0.2"
	},
	"peerDependencies": {
		"@mariozechner/pi-ai": "*",
		"@mariozechner/pi-coding-agent": "*",
		"@mariozechner/pi-tui": "*",
		"typebox": "*"
	},
	"peerDependenciesMeta": {
		"@mariozechner/pi-ai": {
			"optional": true
		},
		"@mariozechner/pi-coding-agent": {
			"optional": true
		},
		"@mariozechner/pi-tui": {
			"optional": true
		},
		"typebox": {
			"optional": true
		}
	},
	"pi": {
		"extensions": [
			"./index.ts"
		],
		"skills": [
			"./skills"
		]
	}
}
