{
	"name": "shorthand-code",
	"version": "0.9.0",
	"description": "Edit repositories with Bun programs, with first-class support for TypeScript and JavaScript: a CLI and a library that Pi's code tool is built on.",
	"keywords": [
		"ast-grep",
		"bun",
		"code-mode",
		"codemod",
		"overlay"
	],
	"homepage": "https://github.com/sebinsua/pi-shorthand/tree/main/packages/shorthand-code#readme",
	"bugs": "https://github.com/sebinsua/pi-shorthand/issues",
	"license": "MIT",
	"author": "Seb Insua",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/sebinsua/pi-shorthand.git",
		"directory": "packages/shorthand-code"
	},
	"bin": {
		"shorthand": "./src/cli/shorthand.ts"
	},
	"files": [
		"src",
		"README.md"
	],
	"type": "module",
	"exports": {
		".": "./src/index.ts"
	},
	"scripts": {
		"prepack": "cp ../../README.md README.md"
	},
	"dependencies": {
		"@ast-grep/cli": "^0.45.3",
		"@ast-grep/napi": "^0.45.3",
		"diff": "^9.0.0",
		"typescript": "7.0.2",
		"vscode-jsonrpc": "^9.0.2"
	},
	"engines": {
		"bun": ">=1.4"
	}
}
