{
	"compilerOptions": {
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "bundler",
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"types": ["bun", "node"]
	},
	"include": ["*.ts", "test/**/*.ts", "e2e/**/*.ts"],
	"exclude": ["node_modules", "e2e/results"]
}
